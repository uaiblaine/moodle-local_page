{{!
    @template local_page/pages_list

    Template for displaying the complete list of pages grouped by status.

    Context variables required for this template:
    * livepages - Array of live pages
    * draftpages - Array of draft pages  
    * archivedpages - Array of archived pages
    * addpageurl - URL to add new page

    Example context (json):
    {
        "livepages": [
            {
                "id": 1,
                "name": "Live Page",
                "status": "live",
                "cardbodyclass": "custompages-card-body rounded mb-3",
                "statusbadge": "<span class=\"badge bg-success text-white\">Live</span>",
                "restricted": false,
                "editurl": "https://example.org/local/page/edit.php?id=1",
                "pageurl": "https://example.org/local/page/?id=1",
                "viewurl": "https://example.org/local/page/?id=1",
                "deleteurl": "https://example.org/local/page/pages.php?pagedel=1&sesskey=abc123",
                "menuname": "live-page",
                "friendlyurl": "https://example.org/live-page"
            }
        ],
        "draftpages": [
            {
                "id": 2,
                "name": "Draft Page",
                "status": "draft",
                "cardbodyclass": "custompages-card-body rounded mb-3 custompages-card-body--draft",
                "statusbadge": "<span class=\"badge bg-warning text-dark\">Draft</span>",
                "restricted": false,
                "editurl": "https://example.org/local/page/edit.php?id=2",
                "pageurl": "https://example.org/local/page/?id=2",
                "viewurl": "https://example.org/local/page/?id=2",
                "deleteurl": "https://example.org/local/page/pages.php?pagedel=2&sesskey=abc123"
            }
        ],
        "archivedpages": [
            {
                "id": 3,
                "name": "Archived Page",
                "status": "archived",
                "cardbodyclass": "custompages-card-body rounded mb-3 custompages-card-body--archived",
                "statusbadge": "<span class=\"badge bg-danger text-white\">Archived</span>",
                "restricted": false,
                "editurl": "https://example.org/local/page/edit.php?id=3",
                "pageurl": "https://example.org/local/page/?id=3",
                "viewurl": "https://example.org/local/page/?id=3",
                "deleteurl": "https://example.org/local/page/pages.php?pagedel=3&sesskey=abc123"
            }
        ],
        "addpageurl": "https://example.org/local/page/edit.php"
    }
}}
<div class="custompages-list-wrapper">
    <div class="custompages-list w-100">
        
        {{! Live pages section }}
        {{#livepages.0}}
            <h3 class="fw-medium mb-3">{{#str}}status_live, local_page{{/str}}</h3>
            <div class="custompages-item mb-4">
                {{#livepages}}
                    {{> local_page/page_card}}
                {{/livepages}}
            </div>
        {{/livepages.0}}

        {{! Draft pages section }}
        {{#draftpages.0}}
            <h3 class="fw-medium mt-6 mb-3">{{#str}}status_draft, local_page{{/str}}</h3>
            <div class="custompages-item mb-4">
                {{#draftpages}}
                    {{> local_page/page_card}}
                {{/draftpages}}
            </div>
        {{/draftpages.0}}

        {{! Archived pages section }}
        {{#archivedpages.0}}
            <h3 class="fw-medium mt-6 mb-3">{{#str}}status_archived, local_page{{/str}}</h3>
            <div class="custompages-item mb-4">
                {{#archivedpages}}
                    {{> local_page/page_card}}
                {{/archivedpages}}
            </div>
        {{/archivedpages.0}}

    </div>

    {{! Add page footer }}
    <div class="custompages-footer mt-4">
        <div class="custompages-list-element">
            <a href="{{{addpageurl}}}" class="custompages-add btn btn-primary">
                {{#str}}addpage, local_page{{/str}}
            </a>
        </div>
    </div>
</div> 
